<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox alignment="CENTER" spacing="10.0"
      xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.nsa.audiogenpremium.SecondaryController">
    <padding><Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/></padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Button text="📂 Select and Split PDF" onAction="#handleUpload"/>
        <!-- fx:id required so controller can disable it when a words window is open -->
        <Button fx:id="switchToPrimaryBtn" text="⇄ Switch to Primary" onAction="#switchToPrimary"/>
        <Button text="📖 Open Word Editor" onAction="#switchToTertiary"/>
        <Button text="🔑 API Key" onAction="#handleChangeApiKey" style="-fx-font-size: 11;"/>
    </HBox>

    <SplitPane dividerPositions="0.28" VBox.vgrow="ALWAYS"
               style="-fx-background-color: #f4f4f4;">
        <VBox spacing="6" style="-fx-padding: 10;">
            <Label text="PAGES"
                   style="-fx-font-size: 13; -fx-font-weight: bold; -fx-text-fill: #555;"/>
<HBox spacing="6" alignment="CENTER_LEFT" style="-fx-padding: 0 0 4 0;">
    <Button text="☑ Select All"      onAction="#handleSelectAll"        style="-fx-font-size: 11;"/>
    <Separator orientation="VERTICAL"/>
    <Label text="Normal:" style="-fx-font-size: 10; -fx-text-fill: #777;"/>
    <Button text="⬇ Fetch Selected"  onAction="#handleFetchSelected"    style="-fx-font-size: 11;"/>
    <Button text="⬇ Fetch All"       onAction="#handleFetchAll"         style="-fx-font-size: 11;"/>
    <Separator orientation="VERTICAL"/>
    <Label text="Force:" style="-fx-font-size: 10; -fx-text-fill: #c0392b;"/>
    <Button text="⚡ Force Selected" onAction="#handleForceFetchSelected"
            style="-fx-font-size: 11; -fx-text-fill: #c0392b;"/>
    <Button text="⚡ Force All"      onAction="#handleForceFetchAll"
            style="-fx-font-size: 11; -fx-text-fill: #c0392b;"/>
</HBox>
            <ListView fx:id="jsonListView" VBox.vgrow="ALWAYS"
                      style="-fx-background-radius: 5;"/>
        </VBox>
        <TabPane fx:id="pdfTabPane" tabClosingPolicy="ALL_TABS"/>
    </SplitPane>
</VBox>